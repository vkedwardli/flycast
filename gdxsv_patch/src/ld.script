SECTIONS
{
    /* Keep networking first; append widescreen, then statistics. */
    . = 0x0C4E0200;
    gdx.data ALIGN(16) : {
        *(gdx.data)
        *(gdx.data.ws)
        *(gdx.data.stats)
    }
    . = 0x0C4F0000;
    gdx.func ALIGN(16) : {
        *(gdx.func)
        *(gdx.func.ws)
        *(gdx.func.stats)
        *(.rodata*)
    }
    /* gdxsv-1.8.11 savestates retain this HUD callback address. */
    ASSERT(gdx_widescreen_hud_render == 0x0C4F0640, "gdxsv-1.8.11 HUD callback address changed")
    . = 0x0C500000;
    gdx.cheat ALIGN(16) : {
        *(gdx.cheat*)
    }
}
